---
// MetricsRibbon.astro - Section 2: Floating Glass Ribbon with Key Ecosystem Stats
---

<section class="relative z-20 -mt-10 max-w-7xl mx-auto px-6 lg:px-12">
  <div class="glass-panel rounded-3xl p-8 lg:p-10 shadow-pedestal border border-white/80 transition-all duration-300 hover:shadow-pedestal-lg">
    
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 divide-y md:divide-y-0 md:divide-x divide-[#D0DCD9]/60">
      
      <!-- Metric 1: Developers -->
      <div class="flex flex-col items-center text-center pt-4 md:pt-0">
        <div class="font-serif text-3xl sm:text-4xl lg:text-5xl font-semibold text-[#1C2A30] tracking-tight">
          8K<span class="text-emerald-600 font-normal">+</span>
        </div>
        <div class="text-xs font-semibold uppercase tracking-kicker text-[#52656B] mt-2">
          Active Developers
        </div>
        <div class="text-[11px] text-[#52656B]/80 font-mono mt-0.5">
          Empowered Globally
        </div>
      </div>

      <!-- Metric 2: Live AI Products -->
      <div class="flex flex-col items-center text-center pt-4 md:pt-0 md:pl-6">
        <div class="font-serif text-3xl sm:text-4xl lg:text-5xl font-semibold text-[#1C2A30] tracking-tight">
          5<span class="text-emerald-600 font-normal"> AI</span>
        </div>
        <div class="text-xs font-semibold uppercase tracking-kicker text-[#52656B] mt-2">
          Products Live
        </div>
        <div class="text-[11px] text-[#52656B]/80 font-mono mt-0.5">
          Full Production Apps
        </div>
      </div>

      <!-- Metric 3: Global Reach -->
      <div class="flex flex-col items-center text-center pt-4 md:pt-0 md:pl-6">
        <div class="font-serif text-3xl sm:text-4xl lg:text-5xl font-semibold text-[#1C2A30] tracking-tight">
          100<span class="text-emerald-600 font-normal">+</span>
        </div>
        <div class="text-xs font-semibold uppercase tracking-kicker text-[#52656B] mt-2">
          Countries Reached
        </div>
        <div class="text-[11px] text-[#52656B]/80 font-mono mt-0.5">
          Zero Geo-Restrictions
        </div>
      </div>

      <!-- Metric 4: Free Forever -->
      <div class="flex flex-col items-center text-center pt-4 md:pt-0 md:pl-6">
        <div class="font-serif text-3xl sm:text-4xl lg:text-5xl font-semibold text-[#1C2A30] tracking-tight">
          $0<span class="text-emerald-600 font-normal"> /mo</span>
        </div>
        <div class="text-xs font-semibold uppercase tracking-kicker text-[#52656B] mt-2">
          100% Free Forever
        </div>
        <div class="text-[11px] text-[#52656B]/80 font-mono mt-0.5">
          Zero Gatekeeping
        </div>
      </div>

    </div>

    <!-- Micro ribbon footer bar -->
    <div class="mt-8 pt-6 border-t border-[#D0DCD9]/50 flex flex-wrap items-center justify-between gap-4 text-xs text-[#52656B]">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
        <span class="font-medium text-[#1C2A30]">99.9% Platform Uptime</span>
        <span>&middot; In-Browser WebAssembly Execution</span>
      </div>
      <div class="flex items-center gap-3 font-mono text-[11px]">
        <span class="px-2.5 py-1 rounded-md bg-[#E8F0EE] text-[#1C2A30] border border-[#D0DCD9]">100% Local Privacy</span>
        <span class="px-2.5 py-1 rounded-md bg-[#E8F0EE] text-[#1C2A30] border border-[#D0DCD9]">Zero API Key Required</span>
      </div>
    </div>

  </div>
</section>
