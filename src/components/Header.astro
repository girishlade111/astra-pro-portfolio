---
// Header.astro - Top Announcement Bar & Sticky Editorial Navbar
---

<header class="w-full sticky top-0 z-50">
  <!-- Section 0: Top Thin Bar -->
  <div class="bg-[#1C2A30] text-[#E3EBE9]/90 py-1.5 px-4 text-xs font-medium text-center tracking-wider flex items-center justify-center gap-2 border-b border-[#2C3E46]/50">
    <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
    <span>Lade Stack Ecosystem is 100% Free &amp; Open-Source &middot; Explore 5+ AI Tools</span>
    <a href="https://ladestack.in" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center text-white underline underline-offset-2 hover:text-emerald-300 transition-colors ml-1">
      Launch Platform &rarr;
    </a>
  </div>

  <!-- Main Editorial Sticky Navbar -->
  <nav class="glass-nav px-6 lg:px-12 py-4 transition-all duration-300">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <!-- Left: Brand Logo -->
      <a href="#" class="group flex items-baseline gap-1.5 focus:outline-none" aria-label="Girish Lade Homepage">
        <span class="font-serif text-2xl lg:text-3xl font-semibold tracking-tight text-[#1C2A30] group-hover:opacity-85 transition-opacity italic">
          Girish Lade
        </span>
        <span class="text-xs font-mono text-[#52656B] -top-2 relative font-normal tracking-widest">
          &reg;
        </span>
      </a>

      <!-- Center: Minimalist Nav Links -->
      <div class="hidden md:flex items-center gap-8 lg:gap-10">
        <a href="#manifesto" class="text-sm font-medium text-[#52656B] hover:text-[#1C2A30] tracking-wide transition-colors">
          Manifesto
        </a>
        <a href="#products" class="text-sm font-medium text-[#52656B] hover:text-[#1C2A30] tracking-wide transition-colors">
          Products
        </a>
        <a href="#editor" class="text-sm font-medium text-[#52656B] hover:text-[#1C2A30] tracking-wide transition-colors">
          Workspace
        </a>
        <a href="#privacy" class="text-sm font-medium text-[#52656B] hover:text-[#1C2A30] tracking-wide transition-colors">
          Architecture
        </a>
        <a href="#techstack" class="text-sm font-medium text-[#52656B] hover:text-[#1C2A30] tracking-wide transition-colors">
          Tech Stack
        </a>
        <a href="#contact" class="text-sm font-medium text-[#52656B] hover:text-[#1C2A30] tracking-wide transition-colors">
          Contact
        </a>
      </div>

      <!-- Right: Search, Stars & Pill CTA -->
      <div class="flex items-center gap-3 lg:gap-4">
        <!-- Minimal Search Button -->
        <button 
          id="search-trigger"
          type="button"
          class="p-2 text-[#52656B] hover:text-[#1C2A30] hover:bg-[#D0DCD9]/40 rounded-full transition-colors focus:outline-none"
          aria-label="Search Ecosystem"
          title="Quick search (Ctrl + K)"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </button>

        <!-- GitHub Star Badge -->
        <a 
          href="https://github.com/girishlade111" 
          target="_blank" 
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-[#1C2A30] bg-[#E8F0EE] hover:bg-[#DCEAE7] border border-[#D0DCD9] rounded-full transition-colors"
          title="GitHub Profile"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>&starf; 8.4k</span>
        </a>

        <!-- Primary Obsidian Pill CTA -->
        <a 
          href="https://ladestack.in" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-5 py-2 text-xs font-semibold tracking-wide text-white bg-[#1C2A30] hover:bg-[#2C3E46] rounded-full shadow-sm hover:shadow-md transition-all duration-300"
        >
          Explore Ecosystem
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button 
          id="mobile-menu-btn"
          type="button" 
          class="md:hidden p-2 text-[#1C2A30] hover:bg-[#D0DCD9]/40 rounded-lg focus:outline-none"
          aria-label="Toggle navigation menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Drawer Menu -->
    <div id="mobile-menu" class="hidden md:hidden pt-4 pb-2 border-t border-[#D0DCD9]/60 mt-3 space-y-2">
      <a href="#manifesto" class="block px-3 py-2 text-sm font-medium text-[#1C2A30] hover:bg-[#E8F0EE] rounded-lg">Manifesto</a>
      <a href="#products" class="block px-3 py-2 text-sm font-medium text-[#1C2A30] hover:bg-[#E8F0EE] rounded-lg">Products</a>
      <a href="#editor" class="block px-3 py-2 text-sm font-medium text-[#1C2A30] hover:bg-[#E8F0EE] rounded-lg">Workspace</a>
      <a href="#privacy" class="block px-3 py-2 text-sm font-medium text-[#1C2A30] hover:bg-[#E8F0EE] rounded-lg">Architecture</a>
      <a href="#techstack" class="block px-3 py-2 text-sm font-medium text-[#1C2A30] hover:bg-[#E8F0EE] rounded-lg">Tech Stack</a>
      <a href="#contact" class="block px-3 py-2 text-sm font-medium text-[#1C2A30] hover:bg-[#E8F0EE] rounded-lg">Contact</a>
      <a href="https://ladestack.in" target="_blank" rel="noopener noreferrer" class="block px-3 py-2 text-sm font-semibold text-white bg-[#1C2A30] text-center rounded-full mt-2">
        Launch LadeStack Platform &rarr;
      </a>
    </div>
  </nav>

  <!-- Search Modal Overlay (Accessible) -->
  <div id="search-modal" class="hidden fixed inset-0 z-50 bg-[#1C2A30]/40 backdrop-blur-sm p-4 flex items-start justify-center pt-24">
    <div class="bg-white border border-[#D0DCD9] rounded-2xl max-w-lg w-full p-6 shadow-pedestal-lg">
      <div class="flex items-center justify-between pb-3 border-b border-[#D0DCD9]">
        <span class="text-xs font-semibold tracking-kicker uppercase text-[#52656B]">Search LadeStack Ecosystem</span>
        <button id="search-close" class="text-[#52656B] hover:text-[#1C2A30] text-sm font-mono">&times; ESC</button>
      </div>
      <div class="mt-4">
        <input 
          id="search-input"
          type="text" 
          placeholder="Search products (e.g. AI Editor, PDF, Resume)..." 
          class="w-full px-4 py-3 bg-[#F4F7F6] border border-[#D0DCD9] rounded-xl text-[#1C2A30] focus:outline-none focus:border-[#1C2A30] text-sm"
        />
      </div>
      <div class="mt-4 space-y-2 text-xs text-[#52656B]">
        <div class="font-medium text-[#1C2A30]">Suggested quick links:</div>
        <div class="flex flex-wrap gap-2 pt-1">
          <a href="#editor" class="px-2.5 py-1 bg-[#E8F0EE] hover:bg-[#D0DCD9] rounded-md text-[#1C2A30]">AI Code Editor</a>
          <a href="#privacy" class="px-2.5 py-1 bg-[#E8F0EE] hover:bg-[#D0DCD9] rounded-md text-[#1C2A30]">LS PDF Toolkit (17-in-1)</a>
          <a href="#products" class="px-2.5 py-1 bg-[#E8F0EE] hover:bg-[#D0DCD9] rounded-md text-[#1C2A30]">Image Compressor</a>
          <a href="#products" class="px-2.5 py-1 bg-[#E8F0EE] hover:bg-[#D0DCD9] rounded-md text-[#1C2A30]">Swift Resume ATS</a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Search modal trigger
  const searchTrigger = document.getElementById('search-trigger');
  const searchModal = document.getElementById('search-modal');
  const searchClose = document.getElementById('search-close');
  const searchInput = document.getElementById('search-input');

  function openSearch() {
    searchModal?.classList.remove('hidden');
    searchInput?.focus();
  }

  function closeSearch() {
    searchModal?.classList.add('hidden');
  }

  searchTrigger?.addEventListener('click', openSearch);
  searchClose?.addEventListener('click', closeSearch);

  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
    if (e.key === 'Escape' && !searchModal?.classList.contains('hidden')) {
      closeSearch();
    }
  });

  searchModal?.addEventListener('click', (e) => {
    if (e.target === searchModal) closeSearch();
  });
</script>
