---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import MetricsRibbon from '../components/MetricsRibbon.astro';
import FeatureShowcase from '../components/FeatureShowcase.astro';
import EcosystemDual from '../components/EcosystemDual.astro';
import PhilosophyStage from '../components/PhilosophyStage.astro';
import ProductsMatrix from '../components/ProductsMatrix.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Girish Lade — Founder & Architect of LadeStack | AI Developer Ecosystem"
  description="Lade Stack unifies code editing, API testing, documentation, and automation into one powerful ecosystem — enterprise-grade, zero cost, built for every developer."
>
  <!-- Section 0: Top Thin Bar & Sticky Navigation -->
  <Header />

  <main>
    <!-- Section 1: Hero Section (1:1 Reference Match) -->
    <Hero />

    <!-- Section 2: Key Metrics Ribbon (Floating Glass Banner) -->
    <MetricsRibbon />

    <!-- Section 3: Alternating Feature Showcase 1 (AI Code Editor & Elevated IDE Plinth) -->
    <FeatureShowcase />

    <!-- Section 4: Dual-Column Ecosystem Grid (Privacy Still-Life & PDF/Image Utilities) -->
    <EcosystemDual />

    <!-- Section 5: Philosophy & Testimonial Stage (Centered Manifesto & Studio Tabs) -->
    <PhilosophyStage />

    <!-- Section 6: All 5 Products & Tech Stack Matrix -->
    <ProductsMatrix />
  </main>

  <!-- Section 7: Editorial Minimalist Footer (4-Column Layout) -->
  <Footer />
</Layout>
