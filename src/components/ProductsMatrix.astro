---
// ProductsMatrix.astro - Section 6: All 5 Flagship Products & Tech Stack Matrix
const products = [
  {
    id: "01",
    title: "AI Code Editor",
    subtitle: "Browser-Native IDE",
    description: "Intelligent in-browser development environment featuring contextual code completion, automated refactoring, real-time syntax checking, and zero-latency sandbox execution.",
    tags: ["WebAssembly", "TypeScript", "Monaco Engine", "Pure Client-Side"],
    badge: "v2.4 Live",
    link: "https://ladestack.in",
    highlight: true,
  },
  {
    id: "02",
    title: "LS PDF Toolkit",
    subtitle: "17-in-1 Document Suite",
    description: "Enterprise-grade PDF operations running 100% client-side. Merge, split, compress, sign, encrypt, and convert multi-page documents without a single byte uploaded to servers.",
    tags: ["PDF-Lib", "Client-Side Encryption", "Zero Telemetry"],
    badge: "17 Tools Included",
    link: "https://ladestack.in",
    highlight: false,
  },
  {
    id: "03",
    title: "LS Image Compressor",
    subtitle: "Lossless / Lossy Engine",
    description: "Next-generation multi-threaded compression engine supporting 9+ formats (PNG, JPEG, WebP, AVIF, SVG) with up to 90% size reduction and zero visual degradation.",
    tags: ["WebAssembly", "Rust/C++", "9+ Formats"],
    badge: "90% Reduction",
    link: "https://ladestack.in",
    highlight: false,
  },
  {
    id: "04",
    title: "Swift Resume",
    subtitle: "ATS Optimizer & Scoring",
    description: "Intelligent resume builder featuring algorithmic ATS keyword scoring, job description matching, instant LaTeX-grade formatting, and high-impact phrase suggestions.",
    tags: ["ATS Scoring", "NLP Parsing", "Export PDF"],
    badge: "ATS Scored",
    link: "https://ladestack.in",
    highlight: false,
  },
  {
    id: "05",
    title: "Bharat Land Converter",
    subtitle: "Geospatial Unit Engine",
    description: "Precision multi-regional land measurement conversion system supporting traditional Indian units (Bigha, Guntha, Acre, Kanal, Marla, Sq. Feet, Hectares) with exact mathematical tolerances.",
    tags: ["Precision Math", "Multi-Unit", "Regional Units"],
    badge: "Multi-State Standard",
    link: "https://ladestack.in",
    highlight: false,
  }
];

const techStack = [
  { name: "Astro", category: "Framework", icon: "🚀" },
  { name: "Tailwind CSS", category: "Styling", icon: "🎨" },
  { name: "TypeScript", category: "Language", icon: "🔷" },
  { name: "React & Next.js", category: "Ecosystem", icon: "⚛️" },
  { name: "WebAssembly (WASM)", category: "Performance", icon: "⚡" },
  { name: "Browser-native AI", category: "Intelligence", icon: "🧠" },
  { name: "Python", category: "Data & ML", icon: "🐍" },
  { name: "Cloudflare Workers", category: "Edge Infrastructure", icon: "🌐" },
];
---

<section id="products" class="py-24 lg:py-32 bg-white relative border-t border-[#D0DCD9]/40">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div>
        <div class="inline-flex items-center gap-2 mb-3">
          <span class="w-6 h-[1px] bg-[#52656B]/60"></span>
          <span class="text-xs font-semibold tracking-kicker uppercase text-[#52656B]">
            PRODUCT ECOSYSTEM
          </span>
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-semibold text-[#1C2A30] tracking-tight">
          Tools engineered <br />
          <span class="italic font-normal">for leverage &amp; speed.</span>
        </h2>
      </div>

      <div class="max-w-md">
        <p class="text-sm sm:text-base text-[#52656B] leading-relaxed">
          Every tool in the LadeStack ecosystem is purpose-built to solve real engineering friction &mdash; zero cost, privacy-first, and always available.
        </p>
      </div>
    </div>

    <!-- 5 Product Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-24">
      {products.map((product) => (
        <div class={`flex flex-col justify-between p-8 rounded-3xl border transition-all duration-300 group ${
          product.highlight 
            ? 'bg-[#E8F0EE] border-[#B8CCC8] shadow-sm hover:shadow-pedestal' 
            : 'bg-[#F9FBFA] border-[#D0DCD9] hover:border-[#1C2A30]/30 hover:bg-white hover:shadow-pedestal'
        }`}>
          <div>
            <!-- Top Card Ribbon -->
            <div class="flex items-center justify-between mb-6">
              <span class="font-mono text-xs text-[#52656B] font-semibold">
                {product.id} &mdash;
              </span>
              <span class="px-2.5 py-1 text-[11px] font-mono font-medium rounded-full bg-white/90 border border-[#D0DCD9] text-[#1C2A30]">
                {product.badge}
              </span>
            </div>

            <!-- Title & Subtitle -->
            <h3 class="font-serif text-2xl font-semibold text-[#1C2A30] tracking-tight group-hover:text-emerald-900 transition-colors">
              {product.title}
            </h3>
            <p class="text-xs font-mono uppercase tracking-wider text-[#52656B] mt-1 mb-4">
              {product.subtitle}
            </p>

            <!-- Description -->
            <p class="text-sm text-[#52656B] leading-relaxed mb-6 font-normal">
              {product.description}
            </p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5 mb-8">
              {product.tags.map((tag) => (
                <span class="px-2.5 py-1 rounded-md text-[11px] font-mono bg-white border border-[#D0DCD9]/80 text-[#52656B]">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Card Launch CTA -->
          <div class="pt-4 border-t border-[#D0DCD9]/60 flex items-center justify-between">
            <a 
              href={product.link} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#1C2A30] group-hover:text-emerald-800 transition-colors"
            >
              <span>Launch Tool</span>
              <span class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
            </a>
            <span class="text-[11px] font-mono text-[#52656B]">Free Forever</span>
          </div>
        </div>
      ))}

      <!-- Special 6th Card: Coming Soon Pipeline -->
      <div class="flex flex-col justify-between p-8 rounded-3xl border border-dashed border-[#D0DCD9] bg-[#F4F7F6]/50">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="font-mono text-xs text-[#52656B] font-semibold">06 &mdash;</span>
            <span class="px-2.5 py-1 text-[11px] font-mono font-medium rounded-full bg-amber-50 border border-amber-200 text-amber-800">
              In Development
            </span>
          </div>
          <h3 class="font-serif text-2xl font-semibold text-[#1C2A30] tracking-tight">
            API Tester &amp; Autonomous Agents
          </h3>
          <p class="text-xs font-mono uppercase tracking-wider text-[#52656B] mt-1 mb-4">
            Next Generation Tools
          </p>
          <p class="text-sm text-[#52656B] leading-relaxed mb-6">
            Automated API load testing, live contract fuzzing, and autonomous client-side agent pipelines to orchestrate full developer workflows.
          </p>
        </div>
        <div class="pt-4 border-t border-[#D0DCD9]/60 flex items-center justify-between text-xs text-[#52656B]">
          <span>Coming to LadeStack</span>
          <span class="font-mono">Q3/Q4 2026</span>
        </div>
      </div>
    </div>

    <!-- Tech Stack Matrix Section -->
    <div id="techstack" class="pt-16 border-t border-[#D0DCD9]/60">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <div class="inline-flex items-center gap-2 mb-2">
          <span class="text-xs font-semibold tracking-kicker uppercase text-[#52656B]">
            ENGINEERING DISCIPLINES &amp; STACK
          </span>
        </div>
        <h3 class="font-serif text-2xl sm:text-3xl font-semibold text-[#1C2A30]">
          Core Technologies &amp; Architecture
        </h3>
      </div>

      <!-- Marquee / Grid of Badges -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-5xl mx-auto">
        {techStack.map((tech) => (
          <div class="p-4 rounded-2xl bg-[#F4F7F6] border border-[#D0DCD9]/80 flex items-center gap-3.5 hover:border-[#1C2A30]/40 transition-colors">
            <span class="text-xl">{tech.icon}</span>
            <div>
              <div class="text-xs font-semibold text-[#1C2A30]">{tech.name}</div>
              <div class="text-[11px] font-mono text-[#52656B]">{tech.category}</div>
            </div>
          </div>
        ))}
      </div>

      <!-- CV / Platform Special Banner Pill -->
      <div class="mt-14 max-w-3xl mx-auto p-6 rounded-2xl bg-[#E8F0EE] border border-[#D0DCD9] flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
        <div>
          <div class="font-serif text-lg font-semibold text-[#1C2A30]">
            Lade Stack &ndash; AI-Powered Developer Platform
          </div>
          <div class="text-xs text-[#52656B] mt-0.5">
            Build Smarter, Ship Faster &middot; Architecture by Girish Lade
          </div>
        </div>
        <a 
          href="https://ladestack.in" 
          target="_blank" 
          rel="noopener noreferrer"
          class="px-6 py-2.5 text-xs font-semibold text-white bg-[#1C2A30] hover:bg-[#2C3E46] rounded-full shadow-sm whitespace-nowrap transition-all duration-300"
        >
          Visit Platform (ladestack.in) &rarr;
        </a>
      </div>

    </div>

  </div>
</section>
