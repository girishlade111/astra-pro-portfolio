---
// Hero.astro - Section 1: 1:1 Reference Match with Girish Lade & Studio Stage
---

<section id="manifesto" class="relative overflow-hidden bg-gradient-to-b from-[#E3EBE9] via-[#E8F0EE] to-[#EEF4F2] pt-8 pb-20 lg:pt-16 lg:pb-28">
  <!-- Architectural Studio Ambient Light Vignette -->
  <div class="absolute inset-0 pointer-events-none opacity-40 bg-[radial-gradient(circle_at_20%_30%,rgba(255,255,255,0.8),transparent_60%)]"></div>
  <div class="absolute right-0 top-0 w-96 h-96 rounded-full bg-white/30 blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Subject Stage with Studio Cutout & Architectural Decor -->
      <div class="lg:col-span-5 relative flex flex-col items-center lg:items-start justify-center order-2 lg:order-1">
        
        <!-- Architectural Backdrop Plinth & Pedestal Glow -->
        <div class="relative w-full max-w-md mx-auto">
          
          <!-- Soft Architectural Pedestal Backdrop -->
          <div class="absolute -inset-4 bg-gradient-to-tr from-white/40 to-white/10 rounded-3xl backdrop-blur-[2px] border border-white/50 -z-10 shadow-pedestal transform -rotate-1"></div>

          <!-- Main Portrait Stage -->
          <div class="relative rounded-2xl overflow-hidden shadow-pedestal bg-[#D9E4E1]/50 border border-white/60 group">
            <img 
              src="/assets/girish-hero.png" 
              alt="Girish Lade — Founder & Architect of LadeStack"
              loading="eager"
              decoding="async"
              srcset="/assets/girish-hero.png 1x, /assets/girish-hero.png 2x"
              class="w-full h-[460px] sm:h-[520px] object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.02]"
            />

            <!-- Subtle Studio Daylight Bottom Vignette -->
            <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[#1C2A30]/60 via-[#1C2A30]/10 to-transparent"></div>

            <!-- Subject Badge Pill -->
            <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between px-4 py-2.5 rounded-xl glass-panel text-xs text-[#1C2A30]">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="font-semibold tracking-wide">Girish Lade</span>
              </div>
              <span class="text-[#52656B] text-[11px] font-mono">Pune, India</span>
            </div>
          </div>

          <!-- Studio Floor Accents (Ref-Matched Architectural Props) -->
          <!-- 1. Ceramic Sage Sphere Plinth -->
          <div class="absolute -bottom-6 -left-6 w-16 h-16 rounded-full bg-gradient-to-br from-[#CBDDD9] via-[#B8CCC8] to-[#97AAA6] shadow-lg border border-white/60 hidden sm:block animate-float-slow"></div>

          <!-- 2. Ceramic Botanical Mini Plinth -->
          <div class="absolute -bottom-5 right-4 px-3.5 py-1.5 rounded-full bg-white/90 backdrop-blur-md shadow-md border border-[#D0DCD9] text-[11px] font-medium text-[#1C2A30] flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
            </svg>
            <span>Founder @ LadeStack</span>
          </div>
        </div>

        <!-- Horizontal Studio Props Shelf (Visual Anchor matching ref floor items) -->
        <div class="w-full max-w-md mx-auto mt-6 pt-4 border-t border-[#D0DCD9]/70 flex items-center justify-between text-xs text-[#52656B]">
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#1C2A30]"></span>
            Mechanical Eng. &rarr; Software
          </span>
          <span class="font-mono text-[11px] text-[#52656B]/90">
            Open Source &middot; 8K+ Devs
          </span>
        </div>
      </div>

      <!-- Center / Right Column: Editorial Typography & Call to Action -->
      <div class="lg:col-span-7 flex flex-col justify-center text-left order-1 lg:order-2 lg:pl-6">
        
        <!-- Refined Uppercase Kicker -->
        <div class="inline-flex items-center gap-2 mb-4">
          <span class="w-6 h-[1px] bg-[#52656B]/60"></span>
          <span class="text-xs font-semibold tracking-kicker uppercase text-[#52656B]">
            MECHANICAL ENGINEER &rarr; SOFTWARE FOUNDER
          </span>
        </div>

        <!-- Main Editorial Serif H1 -->
        <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl xl:text-7xl font-semibold text-[#1C2A30] tracking-tight leading-[1.08] mb-6">
          Build smarter <br class="hidden sm:inline" />
          products with <br class="hidden sm:inline" />
          <span class="italic font-normal">AI tools.</span>
        </h1>

        <!-- Subtitle Bio (Editorial Body Copy) -->
        <p class="text-base sm:text-lg text-[#52656B] leading-relaxed max-w-xl mb-8 font-normal">
          Lade Stack unifies code editing, API testing, documentation, and automation into one powerful ecosystem &mdash; <span class="text-[#1C2A30] font-medium">enterprise-grade, zero cost, built for every developer.</span>
        </p>

        <!-- Primary Action Group (Ref-Matched Pill & Underline Link) -->
        <div class="flex flex-wrap items-center gap-4 sm:gap-6 mb-10">
          <!-- Primary Obsidian Pill Button -->
          <a 
            href="https://ladestack.in" 
            target="_blank" 
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2.5 px-8 py-4 text-sm font-semibold tracking-wide text-white bg-[#1C2A30] hover:bg-[#2C3E46] rounded-full shadow-pedestal hover:shadow-pedestal-lg transition-all duration-300 transform hover:-translate-y-0.5"
          >
            <span>Launch Workspace</span>
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <!-- Secondary Editorial Underline Serif Link -->
          <a 
            href="https://ladestack.in" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm font-serif italic text-[#1C2A30] hover:text-[#52656B] border-b border-[#1C2A30] hover:border-[#52656B] pb-0.5 transition-colors"
          >
            <span>View CV / Platform</span>
            <span class="not-italic">&rarr;</span>
          </a>
        </div>

        <!-- Minimalist Accents: 3D Studio Architectural Floor Lamp & Pedestal Illustration -->
        <div class="p-4 rounded-2xl bg-white/60 border border-white/80 max-w-lg backdrop-blur-sm shadow-sm flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-[#E8F0EE] flex items-center justify-center text-[#1C2A30] font-mono font-semibold text-xs border border-[#D0DCD9]">
              LS
            </div>
            <div>
              <div class="text-xs font-semibold text-[#1C2A30]">Lade Stack Ecosystem</div>
              <div class="text-[11px] text-[#52656B]">100% In-Browser Privacy &middot; Zero Gatekeeping</div>
            </div>
          </div>
          <div class="flex items-center gap-1.5 text-xs font-mono font-medium text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            99.9% Uptime
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
